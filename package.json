{
  "name": "smart-card-server",
  "version": "1.0.0",
  "description": "Smart ID Card app backend (Express + PostgreSQL + Python face_service)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "postinstall": "node scripts/install-python-deps.js",
    "face-service": "python -m uvicorn face_service:app --host 0.0.0.0 --port 8001"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1"
  }
}